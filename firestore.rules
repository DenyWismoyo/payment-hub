rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper: Check if user is an authorized admin
    function isAdmin() {
      return request.auth != null && (
        request.auth.token.email in [
          "deny.wismoyo@gmail.com",
          "wismoyo.dev@gmail.com"
        ]
      );
    }
    
    // Admins Collection
    match /admins/{adminId} {
      allow read, write: if isAdmin();
    }
    
    // Catalogs Collection
    match /catalogs/{catalogId} {
      allow read: if true;
      allow write: if isAdmin();
      
      match /items/{itemId} {
        allow read: if true;
        allow write: if isAdmin();
      }
    }
    
    // Clients Collection
    match /clients/{clientId} {
      allow read, write: if isAdmin();
    }

    // Billings Collection
    match /billings/{billingId} {
      // Admin full access
      allow read, write: if isAdmin();
      // Public reads are handled server-side via adminDb (Next.js API routes)
    }

    // Access Codes Collection
    match /access_codes/{codeId} {
      allow read: if isAdmin();
      allow write: if isAdmin();
      // Public validation is handled server-side via adminDb
    }

    // Payments Collection
    match /payments/{paymentId} {
      allow read: if isAdmin();
      allow write: if false; // Written by webhook handler (server-side) only
    }

    // Tax Allocations Collection
    match /tax_allocations/{allocId} {
      allow read: if isAdmin();
      allow write: if false; // Written by webhook handler (server-side) only
    }
    
    // Webhook Logs
    match /webhook_logs/{logId} {
      allow read: if isAdmin();
      allow write: if false; // Written by Server API only
    }

    // Settings (counters, config)
    match /settings/{settingId} {
      allow read: if isAdmin();
      allow write: if isAdmin();
    }
  }
}
