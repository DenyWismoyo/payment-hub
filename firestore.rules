rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper functions
    function isAdmin() {
      // In this app, we hardcode allowed admin emails on the client.
      // But ideally, we should verify the email domain or specific emails here too.
      // For now, we require the user to be authenticated.
      return request.auth != null && (
        request.auth.token.email == "deny.wismoyo@gmail.com" || 
        request.auth.token.email == "wismoyo.dev@gmail.com"
      );
    }
    
    // Admins Collection
    match /admins/{adminId} {
      allow read, write: if isAdmin();
    }
    
    // Catalogs Collection
    match /catalogs/{catalogId} {
      allow read: if true; // Public can see catalogs (for public endpoints if any)
      allow write: if isAdmin();
      
      match /items/{itemId} {
        allow read: if true;
        allow write: if isAdmin();
      }
    }
    
    // Clients Collection
    match /clients/{clientId} {
      allow read, write: if isAdmin();
    }

    // Billings Collection
    match /billings/{billingId} {
      // Admin can do everything
      allow read, write: if isAdmin();
      
      // Client portal reads are handled via Server API (Next.js), so we don't need to open this up to the public here.
      // The public /api/access-codes fetches billing server-side via adminDb.
      allow read: if false; 
    }
    
    // Webhook Logs
    match /webhook_logs/{logId} {
      allow read: if isAdmin();
      allow write: if false; // Written by Server API only
    }
  }
}
