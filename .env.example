# ─── Next.js ───
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME="SOSO Creative Hub - Payment Center"

# ─── Firebase Client ───
NEXT_PUBLIC_FIREBASE_API_KEY=your_api_key_here
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your_project_id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your_project.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
NEXT_PUBLIC_FIREBASE_APP_ID=your_app_id

# ─── Firebase Admin ───
FIREBASE_ADMIN_PROJECT_ID=your_project_id
FIREBASE_ADMIN_CLIENT_EMAIL=your_service_account@your_project.iam.gserviceaccount.com
FIREBASE_ADMIN_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# ─── Mayar.id API V2 ───
MAYAR_API_BASE_URL=https://api.mayar.id/hl/v2
MAYAR_API_KEY=your_mayar_api_key
MAYAR_WEBHOOK_SECRET=your_webhook_secret
MAYAR_SANDBOX_URL=https://api.mayar.club/hl/v2
MAYAR_USE_SANDBOX=true

# ─── Tax Config ───
DEFAULT_PPN_RATE=12
DEFAULT_PPH23_RATE=2
